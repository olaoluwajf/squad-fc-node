{
  "name": "squad-fc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx --env-file=.env server/index.ts",
    "db:migrate": "tsx --env-file=.env server/db/migrate.ts",
    "db:seed": "tsx --env-file=.env server/db/seed.ts",
    "db:seed:demo": "tsx --env-file=.env server/db/seed.ts --demo",
    "test": "vitest run",
    "test:concurrency": "node scripts/concurrency-test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "latest",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "latest",
    "hono": "latest",
    "jose": "latest",
    "lucide-react": "latest",
    "motion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
